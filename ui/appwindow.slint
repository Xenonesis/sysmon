import { VerticalBox, HorizontalBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "SysMon (Slint PoC)";
    width: 600px;
    height: 400px;
    background: #1a1a1a;
    default-font-family: "Segoe UI";

    in property <string> cpu-usage: "0%";
    in property <string> ram-usage: "0 MB";

    VerticalBox {
        alignment: start;
        padding: 24px;
        spacing: 16px;

        Text {
            text: "System Monitor (Slint Proof of Concept)";
            color: #4ade80;
            font-size: 20px;
            font-weight: 700;
        }

        Rectangle {
            background: #2a2a2a;
            border-radius: 8px;
            padding: 16px;
            height: 120px;

            VerticalBox {
                alignment: center;
                Text {
                    text: "CPU Usage";
                    color: #a3a3a3;
                    font-size: 14px;
                }
                Text {
                    text: root.cpu-usage;
                    color: white;
                    font-size: 32px;
                    font-weight: 600;
                }
            }
        }

        Rectangle {
            background: #2a2a2a;
            border-radius: 8px;
            padding: 16px;
            height: 120px;

            VerticalBox {
                alignment: center;
                Text {
                    text: "Memory Usage";
                    color: #a3a3a3;
                    font-size: 14px;
                }
                Text {
                    text: root.ram-usage;
                    color: white;
                    font-size: 32px;
                    font-weight: 600;
                }
            }
        }
    }
}
