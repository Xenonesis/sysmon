# Build output / release artifacts (root downloads/)
downloads/*
!downloads/.gitkeep

# Docs downloads: only the .gitkeep sentinel is tracked.
# Installer .exe files must NEVER be committed here — they are published
# exclusively via GitHub Releases and served through the GitHub API.
# Committing a versioned .exe here causes stale-version downloads on GitHub Pages.
docs/downloads/*.exe
docs/downloads/*.sha256
docs/downloads/*.spdx.json

# Rust build output
/target
*.pdb

# IDE / tool caches
.vscode/
.idea/
/.superpowers/
/.inno/
dist/
/artifacts/
